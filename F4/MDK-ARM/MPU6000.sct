; Standalone SWD image. All writable objects (including DMA buffers) are in SRAM.
; CCM at 0x10000000 is deliberately excluded because DMA cannot access it.
LR_IROM1 0x08000000 0x00200000 {
  ER_IROM1 0x08000000 0x00200000 {
    *.o (RESET, +First)
    *(InRoot$$Sections)
    .ANY (+RO)
  }
  RW_IRAM1 0x20000000 0x00030000 {
    .ANY (+RW +ZI)
  }
}
